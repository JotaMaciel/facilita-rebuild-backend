generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Usuario {
  id        String    @id @default(uuid()) @db.VarChar(36)
  nome      String    @db.VarChar(120)
  email     String    @unique @db.VarChar(191)
  senhaHash String    @map("senha_hash") @db.VarChar(255)
  papel     Papel     @default(CLIENTE)
  criadoEm  DateTime  @default(now()) @map("criado_em")
  servicos  Servico[] @relation("ContratanteServicos")
  servicosAceitos Servico[] @relation("PrestadorServicos")
  @@map("usuarios")
}
model Servico {
  id         String        @id @default(uuid()) @db.VarChar(36)
  descricao  String        @db.VarChar(500)
  categoria  String        @db.VarChar(80)
  status     StatusServico @default(PENDENTE)
  usuarioId  String        @map("usuario_id") @db.VarChar(36)
  usuario    Usuario       @relation("ContratanteServicos", fields: [usuarioId], references: [id])
  prestadorId String? @map("prestador_id") @db.VarChar(36)
  prestador Usuario? @relation("PrestadorServicos", fields: [prestadorId], references: [id])
  criadoEm   DateTime      @default(now()) @map("criado_em")
  @@index([usuarioId])
  @@index([prestadorId])
  @@map("servicos")
}
enum Papel {
  CLIENTE
  PRESTADOR
  ADMIN
}
enum StatusServico {
  PENDENTE
  ACEITO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}
